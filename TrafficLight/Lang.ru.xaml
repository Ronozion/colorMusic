<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Русский (язык по умолчанию). Английская версия: Lang.en.xaml.
         Выбор языка: RCU системы (ru → этот файл, прочее → en), override: TL_LANG=ru|en -->

    <sys:String x:Key="L.Title">Частотный светофор</sys:String>

    <sys:String x:Key="L.Source">Источник звука</sys:String>
    <sys:String x:Key="L.Start">▶  Запуск</sys:String>
    <sys:String x:Key="L.Stop">⏹  Остановить</sys:String>
    <sys:String x:Key="L.Stopped">Остановлено</sys:String>

    <sys:String x:Key="L.Mode">Режим</sys:String>
    <sys:String x:Key="L.ModeLamps">Светофор</sys:String>
    <sys:String x:Key="L.ModePlates">Частицы — 3 пластины</sys:String>
    <sys:String x:Key="L.ModeField">Частицы — одно поле</sys:String>

    <sys:String x:Key="L.Particles">Частицы на полосу (режим GPU)</sys:String>
    <sys:String x:Key="L.Monitor">Монитор для полного экрана</sys:String>
    <sys:String x:Key="L.RefreshTip">Обновить список мониторов</sys:String>

    <sys:String x:Key="L.Fullscreen">⛶  Полный экран (F11)</sys:String>
    <sys:String x:Key="L.Windowed">🗗  Оконный режим (F11)</sys:String>
    <sys:String x:Key="L.HotkeyHint">F11 — полный экран, Esc — выход, Tab — спрятать/показать панель, двойной клик по экрану — выход из полного экрана.</sys:String>

    <sys:String x:Key="L.AutoNorm">Автономализация по каждой полосе</sys:String>
    <sys:String x:Key="L.AutoNormHint">Каждая полоса подстраивается под свой недавний пик (~4 с), поэтому громкость песни или записи не важна. Шипение и тишина лампы не зажигают.</sys:String>

    <sys:String x:Key="L.Sens">Общая чувствительность</sys:String>
    <sys:String x:Key="L.Threshold">Порог включения (доля от пика полосы)</sys:String>
    <sys:String x:Key="L.Bass">Басы (красный)</sys:String>
    <sys:String x:Key="L.Mids">Середина (зелёный)</sys:String>
    <sys:String x:Key="L.Highs">Верха (жёлтый)</sys:String>

    <sys:String x:Key="L.ChladniHint">В режиме частиц доминирующая частота каждой полосы выбирает узор фигуры Хладни, а уровень полосы «трясёт» пластину.</sys:String>

    <sys:String x:Key="L.PrimaryMarker">  ·  основной</sys:String>
    <sys:String x:Key="L.DevSystemFmt">Системный звук: {0}</sys:String>
    <sys:String x:Key="L.DevMicFmt">Микрофон: {0}</sys:String>
    <sys:String x:Key="L.DevDefault">  (по умолчанию)</sys:String>

    <sys:String x:Key="L.StatusNoDevice">Выберите устройство ввода/воспроизведения.</sys:String>
    <sys:String x:Key="L.StatusSysFmt">Идёт захват системного звука: {0} ({1} Гц)</sys:String>
    <sys:String x:Key="L.StatusMicFmt">Идёт запись с микрофона: {0} ({1} Гц)</sys:String>
    <sys:String x:Key="L.StatusStartErrFmt">Ошибка запуска: {0}</sys:String>
    <sys:String x:Key="L.StatusEnumErrFmt">Не удалось перечислить устройства: {0}</sys:String>
    <sys:String x:Key="L.StatusStopped">Остановлено.</sys:String>
    <sys:String x:Key="L.StatusInterruptedFmt">Запись прервана: {0}</sys:String>
    <sys:String x:Key="L.StatusGpuFallbackFmt">GPU недоступен ({0}) — частицы на CPU.</sys:String>

    <sys:String x:Key="L.ErrTitle">Частотный светофор</sys:String>
    <sys:String x:Key="L.ErrTextFmt">В приложении произошла ошибка:&#10;&#10;{0}&#10;&#10;Подробности: error.log рядом с exe</sys:String>

    <sys:String x:Key="L.BassCaption">БАСЫ</sys:String>
    <sys:String x:Key="L.MidsCaption">СЕРЕДИНА</sys:String>
    <sys:String x:Key="L.HighsCaption">ВЕРХА</sys:String>

    <sys:String x:Key="L.BassBandVis">БАСЫ 20–250 Гц</sys:String>
    <sys:String x:Key="L.MidsBandVis">СЕРЕДИНА 250–2000 Гц</sys:String>
    <sys:String x:Key="L.HighsBandVis">ВЕРХА 2–16 кГц</sys:String>
    <sys:String x:Key="L.HzUnit">Гц</sys:String>

</ResourceDictionary>
